# FinSight REST API (the Streamlit frontend calls this — it never talks to
# Ollama/ChromaDB/SQLite directly). In docker-compose this is overridden to
# http://api:8000 for the ui service.
API_BASE_URL=http://localhost:8000

# Ollama Configuration (only read by the api service)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ChromaDB Configuration
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION=fincorp_policy

# SQLite Database
DATABASE_URL=sqlite:///./finsight.db

# Scoring Configuration
TOXICITY_THRESHOLD=0.5
HALLUCINATION_HIGH_THRESHOLD=0.30
HALLUCINATION_MEDIUM_THRESHOLD=0.10

# Streamlit
STREAMLIT_THEME=dark
